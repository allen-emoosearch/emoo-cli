{
  "auth.token": {
    "method": "GET",
    "path": "/auth/token",
    "auth_required": false,
    "description": "获取 API 访问令牌，默认有效期 2 小时（7200 秒）",
    "params": [
      {"name": "grant_type", "type": "string", "required": false, "desc": "固定为 client_credentials"},
      {"name": "client_id", "type": "string", "required": true, "desc": "客户端标识"},
      {"name": "client_secret", "type": "string", "required": true, "desc": "客户端密钥"}
    ],
    "response": {
      "data.access_token": "string — 访问令牌",
      "data.token_type": "string — Bearer",
      "data.expires_in": "integer — 有效时间(秒)"
    }
  },
  "contact.list": {
    "method": "GET",
    "path": "/ws-user",
    "auth_required": true,
    "user_id_required": false,
    "description": "获取通讯录成员列表（分页）",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数据量，最大 100，默认 50"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "当前页码，从 1 开始"},
      {"name": "keyword", "type": "string", "required": false, "desc": "搜索关键词，不传则返回全部成员"}
    ],
    "response": {
      "data.total": "integer — 总数据量",
      "data.results[]": "WsUserDetailInfo — open_id, user_id, ws_username, ws_user_type(1=普通/2=管理员/3=拥有者), email, mobile_num"
    }
  },
  "contact.update": {
    "method": "PUT",
    "path": "/ws-user",
    "auth_required": true,
    "user_id_required": false,
    "description": "更新成员信息",
    "body": [
      {"name": "open_id", "type": "string", "required": true, "desc": "成员在当前工作区中的唯一标识"},
      {"name": "ws_username", "type": "string", "required": false, "desc": "工作区中的显示名称"},
      {"name": "ext_info", "type": "object", "required": false, "desc": "扩展信息（自由格式 key-value）"}
    ]
  },
  "data.search": {
    "method": "POST",
    "path": "/search",
    "auth_required": true,
    "user_id_required": true,
    "description": "搜索企业绑定的所有数据源（不支持个人数据源）",
    "body": [
      {"name": "keyword", "type": "string", "required": true, "desc": "搜索关键词"},
      {"name": "page_size", "type": "integer", "required": true, "desc": "每页条数（最大 200）"},
      {"name": "current_page", "type": "integer", "required": true, "desc": "页码，从 1 开始"},
      {"name": "text_format", "type": "string", "required": false, "desc": "plain（默认）或 markdown"},
      {"name": "ws_agent_key", "type": "string", "required": false, "desc": "Dify/Coze/Timus 平台的 Agent Key"},
      {"name": "filter_conditions", "type": "array", "required": false, "desc": "二维数组 — 外层 OR，内层 AND"}
    ],
    "response": {
      "data.total": "integer — 总记录数",
      "data.results[]": "DocDetailInfo — id, title, url, content, app_created_at, app_updated_at, ws_app, doc_group"
    },
    "filter_fields": ["id", "app_doc_id", "doc_group.id", "doc_group.app_group_id", "app_updated_at", "app_created_at", "ws_app.ws_app_key"],
    "filter_operators": ["eq", "neq", "in", "nin", "gte", "lte"]
  },
  "data.get": {
    "method": "POST",
    "path": "/data",
    "auth_required": true,
    "user_id_required": true,
    "description": "游标分页获取文档数据",
    "body": [
      {"name": "page_size", "type": "integer", "required": true, "desc": "每页条数（最大 200）"},
      {"name": "cursor", "type": "string", "required": false, "desc": "分页游标，空则从头开始"},
      {"name": "text_format", "type": "string", "required": false, "desc": "plain 或 markdown"},
      {"name": "filter_conditions", "type": "array", "required": false, "desc": "过滤条件，结构同 search"}
    ]
  },
  "chat.list": {
    "method": "GET",
    "path": "/chat",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取用户对话列表（最多前 50 个）",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页条数，默认 50"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码，从 1 开始"}
    ],
    "response": {
      "data.results[]": "id, title, created_at, updated_at"
    }
  },
  "chat.create": {
    "method": "POST",
    "path": "/chat",
    "auth_required": true,
    "user_id_required": true,
    "description": "创建新对话",
    "body": [
      {"name": "title", "type": "string", "required": false, "desc": "对话标题（可选）"}
    ],
    "response": {
      "data.chat_id": "integer — 新建对话 ID"
    }
  },
  "chat.send": {
    "method": "POST",
    "path": "/chat/messages",
    "auth_required": true,
    "user_id_required": true,
    "description": "发送对话消息并获取 AI 回复（不支持 SSE 流式）",
    "body": [
      {"name": "query", "type": "string", "required": true, "desc": "提问/消息内容"},
      {"name": "chat_id", "type": "integer", "required": false, "desc": "对话 ID，为空则创建新对话"},
      {"name": "file_list", "type": "array", "required": false, "desc": "引用文件列表，最多 10 个"},
      {"name": "ws_agent_key", "type": "string", "required": false, "desc": "指定 Agent 回复"},
      {"name": "stream", "type": "boolean", "required": false, "desc": "是否 SSE 流式（当前不支持）"}
    ],
    "response": {
      "data.chat_id": "integer — 对话 ID",
      "data.complete_response": "string — AI 回复内容",
      "data.message_id": "string — 消息 ID"
    }
  },
  "message.push": {
    "method": "POST",
    "path": "/message",
    "auth_required": true,
    "user_id_required": true,
    "description": "主动推送消息给指定用户",
    "body": [
      {"name": "message_type", "type": "string", "required": true, "desc": "normal（普通通知）或 agent（Agent 推送）"},
      {"name": "content", "type": "string", "required": true, "desc": "消息正文，最长 300 字符"},
      {"name": "emoo_user_id", "type": "string", "required": false, "desc": "接收者的 Emoo 用户 ID"},
      {"name": "normal_message_info.from_title", "type": "string", "required": "条件", "desc": "normal 类型必填 — 来源名称"},
      {"name": "normal_message_info.from_image_url", "type": "string", "required": false, "desc": "来源头像 URL"},
      {"name": "normal_message_info.detail_link", "type": "string", "required": false, "desc": "详情链接"},
      {"name": "agent_message_info.ws_agent_key", "type": "string", "required": "条件", "desc": "agent 类型必填 — Agent Key"},
      {"name": "agent_message_info.chat_id", "type": "string", "required": false, "desc": "目标对话 ID"}
    ]
  },
  "base.record-create": {
    "method": "POST",
    "path": "/data/records",
    "auth_required": true,
    "user_id_required": true,
    "description": "插入记录到数据表（最多 100 条）",
    "body": [
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表显示名称（与 table_key 二选一）"},
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表系统标识（与 table_name 二选一）"},
      {"name": "records", "type": "array", "required": true, "desc": "记录列表，1-100 条"}
    ]
  },
  "base.record-update": {
    "method": "PUT",
    "path": "/data/records",
    "auth_required": true,
    "user_id_required": true,
    "description": "更新单条记录（通过 record_key 或 record_title 定位）",
    "body": [
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表显示名称（与 table_key 二选一）"},
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表系统标识（与 table_name 二选一）"},
      {"name": "record_key", "type": "string", "required": "条件", "desc": "记录标识（与 record_title 二选一，优先使用）"},
      {"name": "record_title", "type": "string", "required": "条件", "desc": "记录标题（依赖 title column）"},
      {"name": "fields", "type": "object", "required": true, "desc": "需要更新的字段 JSON 对象"}
    ]
  },
  "base.record-batch-update": {
    "method": "POST",
    "path": "/data/records/batch-update",
    "auth_required": true,
    "user_id_required": true,
    "description": "批量更新记录（最多 100 条）",
    "body": [
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表显示名称（与 table_key 二选一）"},
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表系统标识（与 table_name 二选一）"},
      {"name": "records", "type": "array", "required": true, "desc": "记录数组，每条含 record_key/record_title 和 fields，最多 100 条"}
    ]
  },
  "base.record-delete": {
    "method": "DELETE",
    "path": "/data/records",
    "auth_required": true,
    "user_id_required": true,
    "description": "删除记录（最多 100 条）",
    "body": [
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表显示名称（与 table_key 二选一）"},
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表系统标识（与 table_name 二选一）"},
      {"name": "record_keys", "type": "array", "required": true, "desc": "记录标识数组，最多 100 条"}
    ]
  },
  "base.record-list": {
    "method": "POST",
    "path": "/data/records/list",
    "auth_required": true,
    "user_id_required": true,
    "description": "查询记录列表（分页+过滤+排序）",
    "body": [
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表显示名称（与 table_key 二选一）"},
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表系统标识（与 table_name 二选一）"},
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数量，最大 100，默认 20"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码，从 1 开始"},
      {"name": "filters", "type": "array", "required": false, "desc": "过滤条件数组，格式: 字段:操作符:值"},
      {"name": "sort", "type": "string", "required": false, "desc": "排序（如 created_at:desc）"}
    ]
  },
  "app.list": {
    "method": "GET",
    "path": "/apps",
    "auth_required": true,
    "user_id_required": false,
    "description": "列出工作区所有应用",
    "response": {
      "data[]": "id, ws_app_key, title, doc_group_count, doc_count"
    }
  },
  "app.doc-groups": {
    "method": "GET",
    "path": "/app/{ws_app_key}/doc-groups",
    "auth_required": true,
    "user_id_required": false,
    "description": "列出指定应用的文档组（分页）",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数量，最大 200"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码，从 1 开始"}
    ],
    "path_params": [
      {"name": "ws_app_key", "type": "string", "required": true, "desc": "应用 Key"}
    ]
  },
  "base.table-create": {
    "method": "POST",
    "path": "/data/table",
    "auth_required": true,
    "user_id_required": true,
    "description": "创建数据表，可同时指定初始列定义",
    "body": [
      {"name": "table_name", "type": "string", "required": true, "desc": "表名称"},
      {"name": "extra", "type": "object", "required": false, "desc": "扩展元数据"},
      {"name": "columns", "type": "array", "required": false, "desc": "初始列定义数组，元素为 ColumnDef：column_name(必填)、type(必填，string/number/boolean/date/time/datetime/reference/file/user/group/select)、title_column、multiple、reference_table_key、options、extra"}
    ],
    "response": {
      "data": "TableWithColumns — table_key, table_name, extra, column_count, record_count, created_at, updated_at, columns[]"
    }
  },
  "base.table-list": {
    "method": "GET",
    "path": "/data/table",
    "auth_required": true,
    "user_id_required": true,
    "description": "分页获取数据表列表",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数量，默认 20，最大 100"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码，从 1 开始，默认 1"}
    ],
    "response": {
      "data.total": "integer — 总表数",
      "data.results[]": "TableBrief — table_key, table_name, extra, column_count, record_count, created_at, updated_at"
    }
  },
  "base.table-update": {
    "method": "PUT",
    "path": "/data/table",
    "auth_required": true,
    "user_id_required": true,
    "description": "更新数据表名称或扩展元数据，通过 table_key 或 table_name 定位",
    "body": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"},
      {"name": "new_table_name", "type": "string", "required": "条件", "desc": "新表名称（与 extra 二选一）"},
      {"name": "extra", "type": "object", "required": "条件", "desc": "扩展元数据（与 new_table_name 二选一）"}
    ],
    "response": {
      "data": "TableBrief — table_key, table_name, extra, column_count, record_count"
    }
  },
  "base.table-delete": {
    "method": "DELETE",
    "path": "/data/table",
    "auth_required": true,
    "user_id_required": true,
    "description": "软删除数据表，通过 table_key 或 table_name 定位",
    "body": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"}
    ]
  },
  "base.table-get": {
    "method": "GET",
    "path": "/data/table",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取表详情（当前通过列表+客户端过滤，后续 API 支持直查后切换），通过 table_key 或 table_name 定位",
    "params": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"}
    ],
    "response": {
      "data": "TableWithColumns — table_key, table_name, extra, column_count, record_count, created_at, updated_at, columns[](ColumnInfo)"
    }
  },
  "base.column-add": {
    "method": "POST",
    "path": "/data/table/columns",
    "auth_required": true,
    "user_id_required": true,
    "description": "向数据表添加一列，通过 table_key 或 table_name 定位目标表",
    "body": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"},
      {"name": "column_name", "type": "string", "required": true, "desc": "列名称"},
      {"name": "type", "type": "string", "required": true, "desc": "列类型：string/number/boolean/date/time/datetime/reference/file/user/group/select"},
      {"name": "title_column", "type": "boolean", "required": false, "desc": "是否为标题列，默认 false"},
      {"name": "multiple", "type": "boolean", "required": false, "desc": "是否多选，默认 false"},
      {"name": "reference_table_key", "type": "string", "required": false, "desc": "关联表的 table_key（reference 类型时使用）"},
      {"name": "options", "type": "object", "required": false, "desc": "列选项（select 类型时使用）"},
      {"name": "extra", "type": "object", "required": false, "desc": "扩展元数据"}
    ],
    "response": {
      "data": "ColumnInfo — column_key, column_name, type, table_key, title_column, multiple, order, reference_table_key, options, extra"
    }
  },
  "base.column-update": {
    "method": "PUT",
    "path": "/data/table/columns",
    "auth_required": true,
    "user_id_required": true,
    "description": "更新列属性，通过 table_key/table_name + column_key/column_name 定位",
    "body": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"},
      {"name": "column_key", "type": "string", "required": "条件", "desc": "列标识（与 column_name 二选一）"},
      {"name": "column_name", "type": "string", "required": "条件", "desc": "列名称（与 column_key 二选一）"},
      {"name": "new_column_name", "type": "string", "required": false, "desc": "新列名"},
      {"name": "extra", "type": "object", "required": false, "desc": "扩展元数据"}
    ],
    "response": {
      "data": "ColumnInfo"
    }
  },
  "base.column-delete": {
    "method": "DELETE",
    "path": "/data/table/columns",
    "auth_required": true,
    "user_id_required": true,
    "description": "软删除列，通过 table_key/table_name + column_key/column_name 定位",
    "body": [
      {"name": "table_key", "type": "string", "required": "条件", "desc": "表标识（与 table_name 二选一）"},
      {"name": "table_name", "type": "string", "required": "条件", "desc": "表名称（与 table_key 二选一）"},
      {"name": "column_key", "type": "string", "required": "条件", "desc": "列标识（与 column_name 二选一）"},
      {"name": "column_name", "type": "string", "required": "条件", "desc": "列名称（与 column_key 二选一）"}
    ]
  },

  "agent.list": {
    "method": "GET",
    "path": "/agents",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取当前 workspace 下的 agent 列表（分页），可按 agent_type 过滤",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数量 (1-200, 默认20)"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码 (默认1)"},
      {"name": "agent_type", "type": "string", "required": false, "desc": "类型过滤: webhook / dify / coze / timus"}
    ],
    "response": {
      "data.total": "integer",
      "data.results[]": "Agent — ws_agent_key, title, agent_type, is_enabled, description, scope, created_at, updated_at"
    }
  },
  "agent.create": {
    "method": "POST",
    "path": "/agents",
    "auth_required": true,
    "user_id_required": true,
    "description": "创建 agent。支持 4 种集成类型 (webhook/dify/coze/timus)，config 按类型有不同结构",
    "body": [
      {"name": "title", "type": "string", "required": true, "desc": "Agent 显示名称 (≤100字符)"},
      {"name": "agent_type", "type": "string", "required": true, "desc": "集成类型: webhook / dify / coze / timus"},
      {"name": "config", "type": "object", "required": true, "desc": "集成配置 (WebhookConfig/DifyConfig/CozeConfig/TimusConfig 之一)"},
      {"name": "is_enabled", "type": "boolean", "required": false, "desc": "是否启用 (默认 true)"},
      {"name": "description", "type": "string", "required": false, "desc": "描述"},
      {"name": "scope", "type": "string", "required": false, "desc": "可见范围: public / specified_ws_groups"},
      {"name": "specified_ws_group_ids", "type": "array[integer]", "required": false, "desc": "scope=specified_ws_groups 时必填"}
    ],
    "response": {
      "data": "Agent — ws_agent_key, title, agent_type, is_enabled, description, created_at, updated_at"
    }
  },
  "agent.get": {
    "method": "GET",
    "path": "/agents/{ws_agent_key}",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取指定 agent 的详情",
    "params": [
      {"name": "ws_agent_key", "type": "string", "required": true, "desc": "Agent 唯一标识"}
    ],
    "response": {
      "data": "Agent 完整对象"
    }
  },
  "agent.update": {
    "method": "PATCH",
    "path": "/agents/{ws_agent_key}",
    "auth_required": true,
    "user_id_required": true,
    "description": "部分更新 agent 配置。agent_type 不可修改",
    "params": [
      {"name": "ws_agent_key", "type": "string", "required": true, "desc": "Agent 唯一标识"}
    ],
    "body": [
      {"name": "title", "type": "string", "required": false, "desc": "新名称"},
      {"name": "is_enabled", "type": "boolean", "required": false, "desc": "启用/禁用"},
      {"name": "description", "type": "string", "required": false, "desc": "描述"},
      {"name": "config", "type": "object", "required": false, "desc": "集成配置 (须符合当前 agent_type)"},
      {"name": "scope", "type": "string", "required": false, "desc": "可见范围"},
      {"name": "specified_ws_group_ids", "type": "array[integer]", "required": false, "desc": "角色 ID 列表"}
    ],
    "response": {
      "data": "Agent 完整对象"
    }
  },
  "agent.delete": {
    "method": "DELETE",
    "path": "/agents/{ws_agent_key}",
    "auth_required": true,
    "user_id_required": true,
    "description": "删除 agent",
    "params": [
      {"name": "ws_agent_key", "type": "string", "required": true, "desc": "Agent 唯一标识"}
    ]
  },

  "role.list": {
    "method": "GET",
    "path": "/ws-groups",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取当前 workspace 下的角色列表（分页），支持关键字搜索",
    "params": [
      {"name": "page_size", "type": "integer", "required": false, "desc": "每页数量 (1-200, 默认20)"},
      {"name": "current_page", "type": "integer", "required": false, "desc": "页码 (默认1)"},
      {"name": "keyword", "type": "string", "required": false, "desc": "按角色名称模糊搜索"}
    ],
    "response": {
      "data.total": "integer",
      "data.results[]": "WsGroup — id, group_name, group_desc, created_at"
    }
  },
  "role.create": {
    "method": "POST",
    "path": "/ws-groups",
    "auth_required": true,
    "user_id_required": true,
    "description": "创建角色。group_name 在 workspace 内必须唯一",
    "body": [
      {"name": "group_name", "type": "string", "required": true, "desc": "角色名称 (唯一)"},
      {"name": "group_desc", "type": "string", "required": false, "desc": "角色描述"}
    ],
    "response": {
      "data": "WsGroup — id, group_name, group_desc, created_at"
    }
  },
  "role.update": {
    "method": "PATCH",
    "path": "/ws-groups/{id}",
    "auth_required": true,
    "user_id_required": true,
    "description": "更新角色基础信息（不影响成员关系）",
    "params": [
      {"name": "id", "type": "integer", "required": true, "desc": "角色 ID"}
    ],
    "body": [
      {"name": "group_name", "type": "string", "required": false, "desc": "新名称"},
      {"name": "group_desc", "type": "string", "required": false, "desc": "新描述"}
    ],
    "response": {
      "data": "WsGroup — id, group_name, group_desc, created_at"
    }
  },
  "role.delete": {
    "method": "DELETE",
    "path": "/ws-groups/{id}",
    "auth_required": true,
    "user_id_required": true,
    "description": "删除角色。成员关系自动解除",
    "params": [
      {"name": "id", "type": "integer", "required": true, "desc": "角色 ID"}
    ]
  },
  "role.members-add": {
    "method": "POST",
    "path": "/ws-groups/{id}/members",
    "auth_required": true,
    "user_id_required": true,
    "description": "通过 open_id 批量添加成员到角色（幂等）",
    "params": [
      {"name": "id", "type": "integer", "required": true, "desc": "角色 ID"}
    ],
    "body": [
      {"name": "open_ids", "type": "array[string]", "required": true, "desc": "成员 open_id 列表"}
    ]
  },
  "role.members-remove": {
    "method": "DELETE",
    "path": "/ws-groups/{id}/members/{open_id}",
    "auth_required": true,
    "user_id_required": true,
    "description": "通过 open_id 从角色中移除单个成员（幂等）",
    "params": [
      {"name": "id", "type": "integer", "required": true, "desc": "角色 ID"},
      {"name": "open_id", "type": "string", "required": true, "desc": "成员 open_id"}
    ]
  },

  "base.permission-list": {
    "method": "GET",
    "path": "/data/table/{table_key}/permissions",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取表中已配置的全部权限策略",
    "params": [
      {"name": "table_key", "type": "string", "required": true, "desc": "数据表 key"}
    ],
    "response": {
      "data[]": "PermissionStrategy — role_key, description, audience, data_range, conditions, column_permissions, allow_create/delete/schema_update/schema_delete"
    }
  },
  "base.permission-create": {
    "method": "POST",
    "path": "/data/table/{table_key}/permissions",
    "auth_required": true,
    "user_id_required": true,
    "description": "为指定表创建权限策略，role_key 由后端自动生成",
    "params": [
      {"name": "table_key", "type": "string", "required": true, "desc": "数据表 key"}
    ],
    "body": [
      {"name": "description", "type": "string", "required": false, "desc": "策略描述"},
      {"name": "audience", "type": "object", "required": true, "desc": "受众: {type, user_open_ids?, group_ids?}"},
      {"name": "data_range", "type": "string", "required": false, "desc": "数据范围: all"},
      {"name": "conditions", "type": "array", "required": false, "desc": "过滤条件"},
      {"name": "column_permissions", "type": "object", "required": false, "desc": "列权限映射: {column_key: editable|visible|hidden}"},
      {"name": "allow_create", "type": "boolean", "required": false, "desc": "允许新增记录"},
      {"name": "allow_delete", "type": "boolean", "required": false, "desc": "允许删除记录"},
      {"name": "allow_schema_update", "type": "boolean", "required": false, "desc": "允许修改表结构"},
      {"name": "allow_schema_delete", "type": "boolean", "required": false, "desc": "允许删除表结构"}
    ],
    "response": {
      "data": "PermissionStrategy"
    }
  },
  "base.permission-update": {
    "method": "PUT",
    "path": "/data/table/{table_key}/permissions/{role_key}",
    "auth_required": true,
    "user_id_required": true,
    "description": "整策略覆盖更新。跨表保护：若该 role 同时命中其他表，拒绝更新 (4209)",
    "params": [
      {"name": "table_key", "type": "string", "required": true, "desc": "数据表 key"},
      {"name": "role_key", "type": "string", "required": true, "desc": "策略 ID"}
    ],
    "body": [
      {"name": "description", "type": "string", "required": false, "desc": "策略描述"},
      {"name": "audience", "type": "object", "required": false, "desc": "受众"},
      {"name": "data_range", "type": "string", "required": false, "desc": "数据范围"},
      {"name": "column_permissions", "type": "object", "required": false, "desc": "列权限映射"},
      {"name": "allow_create", "type": "boolean", "required": false},
      {"name": "allow_delete", "type": "boolean", "required": false},
      {"name": "allow_schema_update", "type": "boolean", "required": false},
      {"name": "allow_schema_delete", "type": "boolean", "required": false}
    ],
    "response": {
      "data": "PermissionStrategy"
    }
  },
  "base.permission-delete": {
    "method": "DELETE",
    "path": "/data/table/{table_key}/permissions/{role_key}",
    "auth_required": true,
    "user_id_required": true,
    "description": "物理删除权限策略。跨表保护：若该 role 同时命中其他表，拒绝删除 (4209)",
    "params": [
      {"name": "table_key", "type": "string", "required": true, "desc": "数据表 key"},
      {"name": "role_key", "type": "string", "required": true, "desc": "策略 ID"}
    ],
    "response": {
      "data.role_key": "string",
      "data.deleted": "boolean"
    }
  },

  "folder.list": {
    "method": "GET",
    "path": "/data/folder/items",
    "auth_required": true,
    "user_id_required": true,
    "description": "列出 folder 直接 children (混合 folder+table+document，不递归)。所有成员可调",
    "params": [
      {"name": "folder_id", "type": "integer", "required": false, "desc": "父 folder ID; 不传/null=列根级"}
    ],
    "response": {
      "data.items[]": "混合项: type(folder/table/document), id, name, table_key/doc_id"
    }
  },
  "folder.create": {
    "method": "POST",
    "path": "/data/folder",
    "auth_required": true,
    "user_id_required": true,
    "description": "创建 folder (限 workspace 超管)。同 parent 下名称唯一",
    "body": [
      {"name": "name", "type": "string", "required": true, "desc": "folder 名称 (≤200字符, 同 parent 唯一)"},
      {"name": "parent_id", "type": "integer", "required": false, "desc": "父 folder ID; 不传/null=根 folder"}
    ],
    "response": {
      "data": "folder 对象: id, name, parent_id, table_count, created_at"
    }
  },
  "folder.update": {
    "method": "PUT",
    "path": "/data/folder",
    "auth_required": true,
    "user_id_required": true,
    "description": "更新 folder (改名/移动, 限超管)。name 或 parent_id 至少传一项; parent_id PATCH 语义",
    "body": [
      {"name": "folder_id", "type": "integer", "required": true, "desc": "目标 folder ID"},
      {"name": "name", "type": "string", "required": false, "desc": "新名称 (≤200字符)"},
      {"name": "parent_id", "type": "integer", "required": false, "desc": "不传=不改; null=移到根; int=移到目标"}
    ],
    "response": {
      "data": "folder 对象"
    }
  },
  "folder.delete": {
    "method": "DELETE",
    "path": "/data/folder",
    "auth_required": true,
    "user_id_required": true,
    "description": "删除 folder (限超管)。子孙级联删除, 下属 table/document 上浮到祖父",
    "body": [
      {"name": "folder_id", "type": "integer", "required": true, "desc": "目标 folder ID"}
    ]
  },

  "file.credentials": {
    "method": "POST",
    "path": "/data/files/upload-credentials",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取一批文件的上传凭证 (1-20个, 凭证 1h 过期)。返回 upload 指令 + file_key",
    "body": [
      {"name": "files", "type": "array[object]", "required": true, "desc": "1-20 个文件: [{file_name, file_size, mime_type?}] (file_size ≤100MB)"}
    ],
    "response": {
      "data[]": "上传凭证: file_key, upload(method=PUT直传/POST multipart, url, form_fields?, file_field?)"
    }
  },
  "file.confirm": {
    "method": "POST",
    "path": "/data/files/confirm",
    "auth_required": true,
    "user_id_required": true,
    "description": "确认文件上传完成, 创建文件元数据记录, 返回 24h 下载链接",
    "body": [
      {"name": "files", "type": "array[object]", "required": true, "desc": "1-20 个: [{file_key, file_name, file_size, mime_type?}]"}
    ],
    "response": {
      "data[]": "文件记录: file_key, download_url (24h 有效)"
    }
  },
  "file.download-url": {
    "method": "GET",
    "path": "/data/files/download-url",
    "auth_required": true,
    "user_id_required": true,
    "description": "获取文件下载链接 (24h 有效)。confirm 返回的 URL 过期后用此刷新",
    "params": [
      {"name": "file_key", "type": "string", "required": true, "desc": "文件 file_key"}
    ],
    "response": {
      "data.download_url": "string (24h 有效)"
    }
  }
}
