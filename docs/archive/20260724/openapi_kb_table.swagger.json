        "operationId": "updateColumn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateColumnRequest" },
              "example": { "table_key": "tb_xxx", "column_key": "fld_zzz", "new_column_name": "所属部门" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=200）或业务错误。可能错误码：\n- 4084 invalid_open_api_user_id\n- 4133 base_table_not_found（目标表或 reference 表不存在）\n- 4137 base_column_not_found（column_key/name 不存在）\n- 4138 base_column_name_exists（new_column_name 已被占用）\n- 4199 base_ws_app_not_found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ColumnResponse" }
              }
            }
          },
          "401": {
            "description": "认证失败（4084）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" } } }
          },
          "400": {
            "description": "DRF 字段校验失败（HTTP 400，body.code=400 validation_error）。可能场景：无任何可更新字段、table_key+table_name 都没传、column_key+column_name 都没传、reference 同时传 key 和 name。",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["列管理"],
        "summary": "删除列",
        "description": "软删除。",
        "operationId": "deleteColumn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeleteColumnRequest" },
              "example": { "table_key": "tb_xxx", "column_key": "fld_zzz" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=200）或业务错误。可能错误码：\n- 4084 invalid_open_api_user_id\n- 4133 base_table_not_found\n- 4137 base_column_not_found\n- 4199 base_ws_app_not_found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteResponse" }
              }
            }
          },
          "401": {
            "description": "认证失败（4084）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" } } }
          },
          "400": {
            "description": "DRF 字段校验失败（HTTP 400，body.code=400 validation_error）。可能场景：table_key+table_name 都没传、column_key+column_name 都没传。",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } }
          }
        }
      }
    }
  }
